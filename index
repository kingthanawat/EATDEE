                muscle: "สามารถคงมวลกล้ามเนื้อและกำลังเกร็งนิ้ว/ไหล่ได้ หากได้รับโปรตีน 1.8 - 2.0 g/kg และคาร์โบไฮเดรตเพียงพอช่วงก่อน/หลังปีนผา",
                advice: "เกณฑ์แนะนำสำหรับการลดไขมันของนักปีนผา เพื่อเพิ่ม Strength-to-Weight Ratio โดยไม่เสี่ยงเจ็บป่วย"
            },
            {
                range: "< 30 kcal / kg FFM / day",
                title: "Low Energy Availability (LEA / Zone อันตราย)",
                icon: "⚠️",
                statusTag: "อันตราย: เสี่ยงต่อ REDs และสลายกล้ามเนื้อ",
                tagStyle: "bg-red-100 text-red-900 border-red-300",
                panelBg: "bg-red-50/70 border-red-200",
                rmr: "เข้าสู่โหมดประหยัดพลังงานฉุกเฉิน เกิด Adaptive Thermogenesis รุนแรง RMR ดิ่งลงผิดปกติ (>250-400 kcal/วัน)",
                hormone: "T3 และ Leptin ตกต่ำอย่างรวดเร็ว, Cortisol สูงปรี๊ด เสี่ยงต่อภาวะประจำเดือนผิดปกติในผู้หญิง และเทสโทสเตอโรนต่ำในผู้ชาย",
                muscle: "กระบวนการสังเคราะห์โปรตีน (MPS) ถูกยับยั้ง ร่างกายสลายกล้ามเนื้อและเนื้อเยื่อเกี่ยวพันมาเป็นพลังงาน เสี่ยงบาดเจ็บเอ็นนิ้ว/ไหล่สูงมาก",
                advice: "ควรหลีกเลี่ยงอย่างยิ่ง! หากเข้าสู่โซนนี้เกิน 3-5 วัน ต้องปรับเพิ่มแคลอรีทันทีเพื่อป้องกันภาวะ REDs"
            }
        ];

        // DOM Elements
        const weightInput = document.getElementById('weight');
        const bfInput = document.getElementById('bf');
        const eeeInput = document.getElementById('eee');
        const targetEaSelect = document.getElementById('targetEa');

        const weightVal = document.getElementById('weightVal');
        const bfVal = document.getElementById('bfVal');
        const eeeVal = document.getElementById('eeeVal');
        const targetEaVal = document.getElementById('targetEaVal');

        const ffmDisplay = document.getElementById('ffmDisplay');
        const bmrDisplay = document.getElementById('bmrDisplay');
        const tdeeDeficitDisplay = document.getElementById('tdeeDeficitDisplay');
        const eaTargetDisplay = document.getElementById('eaTargetDisplay');

        const tdeeEaRest = document.getElementById('tdeeEaRest');
        const tdeeEaClimb = document.getElementById('tdeeEaClimb');
        const eaRestIntake = document.getElementById('eaRestIntake');
        const eaClimbIntake = document.getElementById('eaClimbIntake');

        const leaAlert = document.getElementById('leaAlert');
        const leaAlertText = document.getElementById('leaAlertText');

        const macroRestP = document.getElementById('macroRestP');
        const macroRestC = document.getElementById('macroRestC');
        const macroRestF = document.getElementById('macroRestF');
        const macroClimbP = document.getElementById('macroClimbP');
        const macroClimbC = document.getElementById('macroClimbC');
        const macroClimbF = document.getElementById('macroClimbF');

        const totalSessionMin = document.getElementById('totalSessionMin');
        const activeWallMin = document.getElementById('activeWallMin');
        const realisticEeeDisplay = document.getElementById('realisticEeeDisplay');

        // Dynamic EA Detail Panel Elements
        const eaDetailPanel = document.getElementById('eaDetailPanel');
        const detailIcon = document.getElementById('detailIcon');
        const detailRange = document.getElementById('detailRange');
        const detailTitle = document.getElementById('detailTitle');
        const detailStatusTag = document.getElementById('detailStatusTag');
        const detailRmr = document.getElementById('detailRmr');
        const detailHormone = document.getElementById('detailHormone');
        const detailMuscle = document.getElementById('detailMuscle');
        const detailAdvice = document.getElementById('detailAdvice');

        // Chart Instances
        let intakeChart, eaZoneChart;
        let selectedEaIndex = 2; // Default select level 3 (Sweet Spot)

        function selectEaLevel(index) {
            selectedEaIndex = index;
            const data = eaLevelsData[index];

            // Update Panel Text
            detailIcon.textContent = data.icon;
            detailRange.textContent = data.range;
            detailTitle.textContent = data.title;
            detailStatusTag.textContent = data.statusTag;
            detailStatusTag.className = `px-3 py-1 text-xs font-bold rounded-full border ${data.tagStyle}`;
            
            detailRmr.textContent = data.rmr;
            detailHormone.textContent = data.hormone;
            detailMuscle.textContent = data.muscle;
            detailAdvice.textContent = data.advice;

            // Update Panel Container Style
            eaDetailPanel.className = `${data.panelBg} rounded-xl p-6 transition-all duration-300 shadow-sm`;

            // Update Button Highlights
            for (let i = 0; i < 4; i++) {
                const btn = document.getElementById(`eaBtn-${i}`);
                const badge = document.getElementById(`eaBadge-${i}`);
                if (i === index) {
                    btn.classList.add('ring-2', 'ring-amber-500', 'shadow-md');
                    badge.textContent = "กำลังเลือกอยู่";
                    badge.className = "text-[10px] bg-amber-500 text-white px-2 py-0.5 rounded-full font-bold";
                } else {
                    btn.classList.remove('ring-2', 'ring-amber-500', 'shadow-md');
                    badge.textContent = "คลิกเพื่อดู";
                    badge.className = "text-[10px] bg-slate-200 text-slate-700 px-2 py-0.5 rounded-full font-bold";
                }
            }
        }

        function initCharts() {
            // Chart 1: Daily Intake Comparison
            const ctx1 = document.getElementById('intakeChart').getContext('2d');
            intakeChart = new Chart(ctx1, {
                type: 'bar',
                data: {
                    labels: ['วันพัก (Rest Day)', 'วันปีนผาปกติ (Ea Climb)', 'วันปีนผาหนัก (Hard Climb)'],
                    datasets: [
                        {
                            label: 'วิธี TDEE Deficit (-20%)',
                            data: [0, 0, 0],
                            backgroundColor: '#f59e0b',
                            borderRadius: 6
                        },
                        {
                            label: 'วิธี EA Target Strategy',
                            data: [0, 0, 0],
                            backgroundColor: '#2563eb',
                            borderRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: { font: { size: 11 } } },
                        tooltip: {
                            callbacks: {
                                label: (context) => `${context.dataset.label}: ${Math.round(context.raw)} kcal`
                            }
                        }
                    },
                    scales: {
                        y: { beginAtZero: false, title: { display: true, text: 'Energy Intake (kcal)' } }
                    }
                }
            });

            // Chart 2: EA Zone Status
            const ctx2 = document.getElementById('eaZoneChart').getContext('2d');
            eaZoneChart = new Chart(ctx2, {
                type: 'bar',
                data: {
                    labels: ['TDEE: วันพัก', 'TDEE: วันปีนผา', 'EA Strategy: ทุกวัน'],
                    datasets: [{
                        label: 'ค่า EA ที่เกิดขึ้นจริง (kcal/kg FFM)',
                        data: [0, 0, 0],
                        backgroundColor: ['#10b981', '#ef4444', '#2563eb'],
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: (context) => `EA: ${context.raw.toFixed(1)} kcal/kg FFM`
                            }
                        }
                    },
                    scales: {
                        y: { 
                            beginAtZero: true, 
                            max: 50,
                            title: { display: true, text: 'kcal / kg FFM / day' } 
                        }
                    }
                }
            });
        }

        function calculate() {
            const bw = parseFloat(weightInput.value);
            const bf = parseFloat(bfInput.value);
            const eee = parseFloat(eeeInput.value);
            const targetEa = parseFloat(targetEaSelect.value);

            // Update UI labels
            weightVal.textContent = bw;
            bfVal.textContent = bf;
            eeeVal.textContent = eee;
            targetEaVal.textContent = targetEa;

            // Calculations
            const ffm = bw * (1 - (bf / 100));
            const bmr = 370 + (21.6 * ffm);

            // TDEE (Moderately active = 1.55)
            const tdeeBase = bmr * 1.55;
            const tdeeDeficitIntake = tdeeBase * 0.8; // -20%

            // Actual EA under TDEE
            const tdeeActualEaRest = (tdeeDeficitIntake - 0) / ffm;
            const tdeeActualEaClimb = (tdeeDeficitIntake - eee) / ffm;

            // EA Model Strategy
            const eaBaseIntakeRest = targetEa * ffm;
            const eaBaseIntakeClimb = (targetEa * ffm) + eee;

            // Render Numerical Outputs
            ffmDisplay.textContent = ffm.toFixed(1);
            bmrDisplay.textContent = Math.round(bmr).toLocaleString();
            tdeeDeficitDisplay.textContent = Math.round(tdeeDeficitIntake).toLocaleString();
            eaTargetDisplay.textContent = `${Math.round(eaBaseIntakeRest).toLocaleString()} - ${Math.round(eaBaseIntakeClimb).toLocaleString()}`;

            tdeeEaRest.textContent = `${tdeeActualEaRest.toFixed(1)} kcal`;
            tdeeEaClimb.textContent = `${tdeeActualEaClimb.toFixed(1)} kcal (${tdeeActualEaClimb < 30 ? 'LEA!' : 'Safe'})`;
            tdeeEaClimb.className = `font-bold ${tdeeActualEaClimb < 30 ? 'text-red-600' : 'text-emerald-600'}`;

            eaRestIntake.textContent = `${Math.round(eaBaseIntakeRest).toLocaleString()} kcal`;
            eaClimbIntake.textContent = `${Math.round(eaBaseIntakeClimb).toLocaleString()} kcal`;

            // Dynamic Alert for LEA
            if (tdeeActualEaClimb < 30) {
                leaAlert.className = "p-4 rounded-xl bg-red-100 text-red-900 border border-red-200 text-xs flex items-start space-x-3";
                leaAlertText.textContent = `หากรับประทานอาหารตามโมเดล TDEE (${Math.round(tdeeDeficitIntake)} kcal) ในวันปีนผา ค่า EA ของคุณจะลดลงเหลือเพียง ${tdeeActualEaClimb.toFixed(1)} kcal/kg FFM/day ซึ่งต่ำกว่าเกณฑ์ความปลอดภัย (<30 kcal) เสี่ยงต่อภาวะ LEA, การสลายกล้ามเนื้อ และ RMR ปรับลดลง!`;
            } else {
                leaAlert.className = "p-4 rounded-xl bg-emerald-100 text-emerald-900 border border-emerald-200 text-xs flex items-start space-x-3";
                leaAlertText.textContent = `ค่า EA ในวันปีนผาตามวิธี TDEE อยู่ที่ ${tdeeActualEaClimb.toFixed(1)} kcal/kg FFM/day ซึ่งยังอยู่ในเกณฑ์ที่ยอมรับได้ แต่หากวันใดออกกำลังกายหนักขึ้น ค่า EA อาจตกเข้าสู่ภาวะ LEA ได้`;
            }

            // Macros Calculation
            const restP = bw * 1.8;
            const restF = (eaBaseIntakeRest * 0.25) / 9;
            const restC = (eaBaseIntakeRest - (restP * 4) - (restF * 9)) / 4;

            const climbP = bw * 2.0;
            const climbF = (eaBaseIntakeClimb * 0.25) / 9;
            const climbC = (eaBaseIntakeClimb - (climbP * 4) - (climbF * 9)) / 4;

            macroRestP.textContent = `${Math.round(restP)}g (${Math.round(restP * 4)} kcal)`;
            macroRestC.textContent = `${Math.round(restC)}g (${Math.round(restC * 4)} kcal)`;
            macroRestF.textContent = `${Math.round(restF)}g (${Math.round(restF * 9)} kcal)`;

            macroClimbP.textContent = `${Math.round(climbP)}g (${Math.round(climbP * 4)} kcal)`;
            macroClimbC.textContent = `${Math.round(climbC)}g (${Math.round(climbC * 4)} kcal)`;
            macroClimbF.textContent = `${Math.round(climbF)}g (${Math.round(climbF * 9)} kcal)`;

            // Update Charts
            if (intakeChart && eaZoneChart) {
                intakeChart.data.datasets[0].data = [tdeeDeficitIntake, tdeeDeficitIntake, tdeeDeficitIntake];
                intakeChart.data.datasets[1].data = [eaBaseIntakeRest, eaBaseIntakeClimb, eaBaseIntakeRest + eee + 150];
                intakeChart.update();

                eaZoneChart.data.datasets[0].data = [tdeeActualEaRest, tdeeActualEaClimb, targetEa];
                eaZoneChart.update();
            }
        }

        function calculateRealisticEee() {
            const activeMin = parseFloat(activeWallMin.value) || 0;
            const realisticEee = activeMin * 11; // ~11 kcal/min on wall
            realisticEeeDisplay.textContent = `${Math.round(realisticEee)} kcal`;
        }

        // Event Listeners
        [weightInput, bfInput, eeeInput, targetEaSelect].forEach(element => {
            element.addEventListener('input', calculate);
        });

        [totalSessionMin, activeWallMin].forEach(element => {
            element.addEventListener('input', calculateRealisticEee);
        });

        // Initialize on Load
        document.addEventListener('DOMContentLoaded', () => {
            initCharts();
            calculate();
            calculateRealisticEee();
            selectEaLevel(2); // Default to Sweet spot
        });
    </script>
</body>
</html>
